# ThreadAtlas environment template.
# Copy to `.env.local` (git-ignored) and adjust. Never put secrets or real data here.
# This file is committed; `.env*` files other than this one are git-ignored.

# --- Privacy -----------------------------------------------------------------
# Next.js telemetry. The npm scripts already set this inline; kept here for
# tools run outside the scripts.
NEXT_TELEMETRY_DISABLED=1

# Prisma 7.10.1. Its CLI telemetry ("checkpoint") is off when CHECKPOINT_DISABLE
# is set; the `db:*` npm scripts set it inline and also run the CLI with a
# non-interactive stdin, which prevents its survey, skills-offer and error-report
# prompts (verified in the 7.10.1 source; see docs/PROGRESS.md). Always use the npm
# scripts rather than `npx prisma` in a terminal. Kept here for tools run outside them.
CHECKPOINT_DISABLE=1
PRISMA_HIDE_UPDATE_MESSAGE=1

# --- Import ------------------------------------------------------------------
# Maximum accepted upload size in bytes. 52428800 = 50 MiB. Enforced while the
# request is read. Used by the import route (M1.5).
IMPORT_MAX_BYTES=52428800

# --- Database ----------------------------------------------------------------
# SQLite database. Leave unset to use the default `<project>/data/threadatlas.db`
# (git-ignored). If set, it must be `file:` followed by an ABSOLUTE path; relative
# paths are rejected because Prisma does not document how they resolve.
# The app never creates the database: run `npm run db:deploy` once (asks nothing,
# creates the folder 0700 and the file 0600). Tests never read this setting:
# they always use temporary databases and refuse anything else.
# DATABASE_URL=file:/absolute/path/to/threadatlas/data/threadatlas.db

# --- Semantic model (M5.1a) ----------------------------------------------------
# Folder with the local embedding model. Leave unset to use the default
# `<project>/data/models/multilingual-e5-small` (git-ignored). If set, it must be an
# ABSOLUTE path. Install the files with `npm run model:fetch` (the only command that
# downloads the model); the app never downloads anything itself.
# THREADATLAS_MODEL_DIR=/absolute/path/to/models/multilingual-e5-small
