// ThreadAtlas M1 schema (plan §4, amendments A34–A42). SQLite via the
// better-sqlite3 driver adapter; the connection URL comes from
// prisma.config.ts (src/lib/db/path.ts).
//
// Strings stand in for enums and are validated in TypeScript. CHECK
// constraints are deliberately absent: Prisma cannot express them and would
// drop hand-written ones when it next rebuilds a SQLite table.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// One upload. Times generated by the app use DateTime (A36).
model ImportBatch {
  id                     String         @id @default(cuid())
  startedAt              DateTime       @default(now())
  finishedAt             DateTime?
  /// running | succeeded | succeeded_with_warnings | completed_with_errors | failed | interrupted (M1.4)
  status                 String
  /// "chatgpt"
  adapter                String
  /// Parser version, e.g. "0.3.0"
  adapterVersion         String
  sourceFilename         String
  sourceSha256           String
  sourceBytes            Int
  /// Every conversation discovered in the file. For succeeded, succeeded_with_warnings and
  /// completed_with_errors: seen = added + updated + unchanged + older + flagged + skipped.
  /// For failed and interrupted, seen − that sum = conversations not accounted for (M1.4).
  conversationsSeen      Int            @default(0)
  conversationsAdded     Int            @default(0)
  conversationsUpdated   Int            @default(0)
  conversationsUnchanged Int            @default(0)
  /// Valid but older incoming copy (A38, Q4)
  conversationsOlder     Int            @default(0)
  /// Not imported until resolved (I8, A38)
  conversationsFlagged   Int            @default(0)
  conversationsSkipped   Int            @default(0)
  /// Versioned, bounded, content-free warning report (A39)
  warningsJson           String?
  errorCode              String?
  firstImported          Conversation[] @relation("FirstImport")
  lastImported           Conversation[] @relation("LastImport")

  @@index([sourceSha256])
  @@index([startedAt])
}

model Conversation {
  /// Internal key; never taken from the export (A35)
  id                  String       @id @default(cuid())
  /// Provider namespace, e.g. "chatgpt"
  source              String
  /// Provider's ID, or "derived:v1:<sha256>" (A20); at most 512 characters (Q12)
  sourceId            String
  /// conversation_id | id | derived
  idSource            String
  title               String?
  /// Source time in epoch seconds, sub-millisecond precision kept (A36)
  createdAtSec        Float?
  updatedAtSec        Float?
  /// As exported (at most 512 characters); may not be in the mapping
  currentNodeSourceId String?
  /// current_node | latest_leaf | last_child | none
  pathStrategy        String
  visibleMessageCount Int
  nodeCount           Int
  /// "v1:<sha256 hex>"; v1 is frozen (A34)
  contentHash         String
  parserVersion       String
  firstImportBatchId  String?
  lastImportBatchId   String?
  firstImportBatch    ImportBatch? @relation("FirstImport", fields: [firstImportBatchId], references: [id], onDelete: SetNull)
  lastImportBatch     ImportBatch? @relation("LastImport", fields: [lastImportBatchId], references: [id], onDelete: SetNull)
  messages            Message[]
  /// Semantic index (M5.1b): derived data, removed with the conversation
  embeddingStatus     EmbeddingStatus?
  embeddingChunks     EmbeddingChunk[]

  @@unique([source, sourceId])
  @@index([updatedAtSec])
  @@index([firstImportBatchId])
  @@index([lastImportBatchId])
}

/// One row per mapping node, including structural nodes (R22).
model Message {
  id                  String       @id @default(cuid())
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Mapping key
  sourceNodeId        String
  sourceMessageId     String?
  /// As exported; may dangle, so deliberately not a foreign key (A23)
  parentSourceNodeId  String?
  siblingIndex        Int
  /// Position on the default path; null = off the path
  pathIndex           Int?
  isStructural        Boolean      @default(false)
  isMalformed         Boolean      @default(false)
  /// Exactly as exported; null = missing or invalid (A29)
  role                String?
  authorName          String?
  contentType         String?
  contentText         String       @default("")
  codeLanguage        String?
  hasUnsupportedParts Boolean      @default(false)
  /// Opaque original payload, unsupported content only (A28, A37).
  /// Never selected by routine queries, never logged or returned by ordinary APIs.
  rawContentJson      String?
  isHidden            Boolean      @default(false)
  status              String?
  /// Source time in epoch seconds (A36)
  createdAtSec        Float?

  @@unique([conversationId, sourceNodeId])
  @@index([conversationId, pathIndex])
  @@index([conversationId, parentSourceNodeId])
}

/// Semantic index configuration and counters (M5.1b). At most one row (id "main"),
/// created at the first Start, never by the migration. Kept by delete-all: it
/// holds versions and counters only, no imported data.
model EmbeddingIndex {
  /// Always "main" (one row)
  id               String   @id
  /// Incremented by delete-all and by every configuration change; never decreases
  epoch            Int
  /// EMBEDDING_VERSION (model, revision, prefixes, truncation, pooling, batching, windows)
  embeddingVersion String
  /// CHUNKER_VERSION
  chunkerVersion   String
  chunkTokens      Int
  /// QUANTIZATION_VERSION
  quantization     String
  dimensions       Int
  /// Incremented by every commit or deletion of chunks (M5.2 cache invalidation)
  changeCounter    Int
  /// Last run-level error code (static codes only)
  lastErrorCode    String?
  updatedAt        DateTime
}

/// Indexing state of one conversation (M5.1b). Kept after success, so a
/// conversation with zero eligible messages is not queued again.
model EmbeddingStatus {
  conversationId String       @id
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// The conversation version this row refers to: (contentHash, parserVersion)
  contentHash    String
  parserVersion  String
  /// Index epoch when queued; for "indexed", the epoch of the commit
  epoch          Int
  /// pending | running | indexed | failed
  state          String
  /// Random 128-bit hex while running; cleared by any re-queue
  claimToken     String?
  attempts       Int
  /// Number of chunks committed; set only when indexed (0 is valid)
  chunkCount     Int?
  /// Static error code, e.g. INFERENCE_FAILED, CONVERSATION_TOO_LARGE
  lastErrorCode  String?
  queuedAt       DateTime
  updatedAt      DateTime

  @@index([state, queuedAt])
}

/// One chunk vector (M5.1b). No text: the chunk is
/// Message.contentText.slice(start, end) of (conversationId, sourceNodeId).
model EmbeddingChunk {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// The conversation version embedded
  contentHash    String
  parserVersion  String
  /// Index epoch at commit
  epoch          Int
  /// Message provenance (A62)
  sourceNodeId   String
  /// Position within the message
  chunkIndex     Int
  /// UTF-16 offsets into Message.contentText
  start          Int
  end            Int
  /// At most 64
  tokenCount     Int
  /// The chunker's content-addressed id (32 hex)
  chunkKey       String
  /// int8-absmax-v1, 388 bytes
  vector         Bytes

  @@id([conversationId, sourceNodeId, chunkIndex])
  @@index([epoch])
}
