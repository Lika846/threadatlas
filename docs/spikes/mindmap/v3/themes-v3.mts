// Mind-map spike v3, step 1: a label-free rule for the THEME level of the production tree.
// Topics are the production cut (`chooseTopicCut`); themes are a coarser cut of the same
// average-linkage tree, so every topic sits inside exactly one theme. Candidate rules are
// compared on the dev set (v1, 94 conversations, used for choosing) and confirmed on the test
// set (v2, 453 conversations, held out for this question), with subsample stability and size
// drift. Labels are read only to score. Synthetic data only.
// Usage: fnm exec --using=24 -- node docs/spikes/mindmap/v3/themes-v3.mts <v1.json> <v2.json> <out.md>
import fs from "node:fs";
import { averageLinkage, chooseTopicCut, cutTree, type Merge } from "../../../../src/lib/semantic/topics/hierarchy.ts";
import * as A from "../algorithms.mts";
import { load, productionVectors, sample, type Item } from "./shared-v3.mts";

const ROOT = process.cwd();
const [v1File, v2File, outFile] = process.argv.slice(2);
if (!v1File || !v2File || !outFile) throw new Error("usage: themes-v3.mts <v1.json> <v2.json> <out.md>");

type Rule = { name: string; cut: (n: number, merges: readonly Merge[], topicCut: number) => number };
const steps = (from: number, to: number) => Array.from({ length: Math.round((to - from) * 100) + 1 }, (_, i) => Math.round(from * 100 + i) / 100);
const groupCount = (a: readonly number[]) => {
  const c = new Map<number, number>();
  for (const x of a) c.set(x, (c.get(x) ?? 0) + 1);
  return [...c.values()].filter((s) => s >= 2).length;
};
const largest = (a: readonly number[]) => {
  const c = new Map<number, number>();
  for (const x of a) c.set(x, (c.get(x) ?? 0) + 1);
  return Math.max(...c.values()) / a.length;
};

const RULES: Rule[] = [
  { name: "fixed t = 0.90", cut: () => 0.9 },
  { name: "fixed t = 0.95", cut: () => 0.95 },
  ...[8, 10, 12, 15].map((k) => ({
    name: `fewest-steps to ≤ ${k} themes`,
    cut: (n: number, m: readonly Merge[], t0: number) => steps(Math.max(t0, 0.8), 1.2).find((t) => groupCount(cutTree(n, m, t)) <= k) ?? 1.2,
  })),
  ...[0.15, 0.2, 0.25].map((p) => ({
    name: `coarsest with largest ≤ ${p * 100}%`,
    cut: (n: number, m: readonly Merge[], t0: number) => [...steps(Math.max(t0, 0.8), 1.2)].reverse().find((t) => largest(cutTree(n, m, t)) <= p) ?? Math.max(t0, 0.8),
  })),
  {
    name: "largest height gap above the topic cut",
    cut: (n: number, m: readonly Merge[], t0: number) => {
      const hs = m.map((x) => x.height).filter((h) => h > t0 + 0.05 && h < 1.15).sort((a, b) => a - b);
      let best = 0;
      let at = 0.9;
      for (let i = 1; i < hs.length; i++) if (hs[i]! - hs[i - 1]! > best) [best, at] = [hs[i]! - hs[i - 1]!, (hs[i]! + hs[i - 1]!) / 2];
      return at;
    },
  },
];

function themeMetrics(items: readonly Item[], assign: readonly number[]) {
  const g = A.toGrouping(assign, 2);
  const labels = items.map((c) => c.themes);
  const b3 = A.bcubed(g, labels);
  const groups = [...A.groupsOf(g).values()];
  let catchAll = 0;
  let multiLang = 0;
  for (const m of groups) {
    const tc = new Map<string, number>();
    for (const i of m) for (const t of labels[i]!) tc.set(t, (tc.get(t) ?? 0) + 1);
    const top = [...tc].sort((a, b) => b[1] - a[1])[0]![0];
    if (m.length >= 5 && m.filter((i) => !labels[i]!.includes(top)).length / m.length > 0.5) catchAll++;
    if (m.length >= 5 && new Set(m.map((i) => items[i]!.lang)).size >= 2) multiLang++;
  }
  const big = groups.filter((m) => m.length >= 5).length;
  return { f: b3.f, p: b3.p, r: b3.r, themes: groups.length, largest: largest(assign), unsorted: g.filter((x) => x.length === 0).length / items.length, catchAll, multiLang: big ? multiLang / big : 0 };
}

function tree(items: readonly Item[]) {
  const { centred } = productionVectors(items);
  const merges = averageLinkage(centred);
  return { merges, topicCut: chooseTopicCut(items.length, merges) };
}

const fmt = (x: number, d = 2) => x.toFixed(d);
const pct = (x: number) => `${Math.round(x * 100)}%`;
const lines: string[] = ["# Spike v3, step 1: theme-level cut rules", "", "Generated by `themes-v3.mts`. Theme-level B³ F against the theme labels (one-offs are their own label).", ""];

for (const [set, file] of [["dev", v1File], ["test", v2File]] as const) {
  const items = load(set, file, ROOT);
  const { merges, topicCut } = tree(items);
  const topicG = A.toGrouping(cutTree(items.length, merges, topicCut), 2);
  lines.push(`## ${set === "dev" ? "Dev set (v1, choosing)" : "Test set (v2, confirming)"}: ${items.length} conversations`, "");
  lines.push(`Topic cut (production rule): t = ${topicCut}, ${[...A.groupsOf(topicG).values()].length} topics, topic-level B³ F ${fmt(A.bcubed(topicG, items.map((c) => c.topics)).f)}.`, "");
  lines.push("| Rule | t | Themes | Largest | Alone | B³ P | B³ R | B³ F | Catch-alls | Multi-language (≥5) |", "| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |");
  for (const rule of RULES) {
    const t = rule.cut(items.length, merges, topicCut);
    const m = themeMetrics(items, cutTree(items.length, merges, t));
    lines.push(`| ${rule.name} | ${fmt(t)} | ${m.themes} | ${pct(m.largest)} | ${pct(m.unsorted)} | ${fmt(m.p)} | ${fmt(m.r)} | **${fmt(m.f)}** | ${m.catchAll} | ${pct(m.multiLang)} |`);
  }
  lines.push("");
  if (set === "test") {
    // Stability: 10 subsamples of 80%; ARI of the theme assignment on the shared items.
    lines.push("**Stability on the test set** (10 subsamples of 80%; mean ARI with the full-set themes on shared items) and **drift with size** (theme count and t at 100 / 200 / 300 / 453 conversations, mean of 5 samples):", "");
    lines.push("| Rule | Stability (ARI) | Themes at 100 / 200 / 300 / 453 | t at 100 / 200 / 300 / 453 |", "| --- | --- | --- | --- |");
    for (const rule of RULES) {
      const full = cutTree(items.length, merges, rule.cut(items.length, merges, topicCut));
      let ari = 0;
      for (let s = 0; s < 10; s++) {
        const idx = sample(items.map((_, i) => i), Math.round(items.length * 0.8), 100 + s).sort((a, b) => a - b);
        const sub = idx.map((i) => items[i]!);
        const st = tree(sub);
        const a = cutTree(sub.length, st.merges, rule.cut(sub.length, st.merges, st.topicCut));
        ari += A.ari(a, idx.map((i) => full[i]!)) / 10;
      }
      const drift = [100, 200, 300, items.length].map((size) => {
        let themes = 0;
        let tt = 0;
        const reps = size === items.length ? 1 : 5;
        for (let s = 0; s < reps; s++) {
          const sub = size === items.length ? [...items] : sample(items, size, 200 + s);
          const st = tree(sub);
          const t = rule.cut(sub.length, st.merges, st.topicCut);
          themes += groupCount(cutTree(sub.length, st.merges, t)) / reps;
          tt += t / reps;
        }
        return { themes, t: tt };
      });
      lines.push(`| ${rule.name} | ${fmt(ari)} | ${drift.map((d) => d.themes.toFixed(0)).join(" / ")} | ${drift.map((d) => fmt(d.t)).join(" / ")} |`);
    }
    lines.push("");
  }
}
fs.writeFileSync(outFile, lines.join("\n") + "\n");
console.log(lines.join("\n"));
