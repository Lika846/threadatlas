// Mind-map spike v3, step 2: the production hierarchy (`themes.ts`) on both sets, read as lists,
// and naming variants scored. Labels are read only for the scored listing and the metrics; the
// blind listing (no labels) is written separately and was read first.
//
// Naming check, label-free in what it rewards: each name is embedded as a search query by the
// production model, and must find its own group among all groups of its level (cosine with the
// group's mean raw chunk vector). Reported as top-1 accuracy and mean reciprocal rank. Also:
// coverage (share of a group's conversations that contain a naming word) and the share of word
// names that fall back to a title. Synthetic data only.
// Usage: fnm exec --using=24 -- node docs/spikes/mindmap/v3/names-v3.mts <v1.json> <v2.json> <outdir>
import fs from "node:fs";
import path from "node:path";
import { InferenceProcess, productionChildEntry } from "../../../../src/lib/semantic/inference-process.ts";
import { resolveModelDir } from "../../../../src/lib/semantic/model-files.ts";
import { detectLanguage, resolveLanguages, type Lang } from "../../../../src/lib/semantic/topics/lang.ts";
import { createNamer, displayName, typicalTitles, wordKey, words, type NamingDoc } from "../../../../src/lib/semantic/topics/naming.ts";
import { buildHierarchy } from "../../../../src/lib/semantic/topics/themes.ts";
import { CONCEPTS } from "../../../../src/lib/semantic/topics/concepts.ts";
import { GOLD_NAMES } from "./gold-names.mjs";
import { load, productionVectors, type Item } from "./shared-v3.mts";

const ROOT = process.cwd();
const [v1File, v2File, outDir] = process.argv.slice(2);
if (!v1File || !v2File || !outDir) throw new Error("usage: names-v3.mts <v1.json> <v2.json> <outdir>");
fs.mkdirSync(outDir, { recursive: true });

function mainLang(c: Item): Lang {
  const langs = resolveLanguages(c.messages.map((m) => detectLanguage(m)));
  const count = new Map<Lang, number>();
  for (const l of langs) count.set(l, (count.get(l) ?? 0) + 1);
  return [...count].sort((a, b) => b[1] - a[1])[0]![0];
}
function namingDoc(c: Item, withText: boolean): NamingDoc {
  const user = new Set(c.chunks.filter((k) => k.role === "user").map((k) => k.msg));
  return { title: c.title, text: withText ? c.messages.filter((_, i) => user.has(i)).join("\n") : "", lang: mainLang(c) };
}
const meanRaw = (items: readonly Item[], members: readonly number[]) => {
  const dims = items[0]!.chunks[0]!.v.length;
  const s = new Float64Array(dims);
  for (const i of members) for (const k of items[i]!.chunks) for (let d = 0; d < dims; d++) s[d]! += k.v[d]!;
  const n = Math.hypot(...s) || 1;
  return s.map((x) => x / n);
};
const cos = (a: Float32Array, b: Float64Array) => {
  let s = 0;
  for (let i = 0; i < a.length; i++) s += a[i]! * b[i]!;
  return s;
};
const majority = (labels: readonly string[][], members: readonly number[]) => {
  const c = new Map<string, number>();
  for (const i of members) for (const l of labels[i]!) c.set(l, (c.get(l) ?? 0) + 1);
  const [top, k] = [...c].sort((a, b) => b[1] - a[1] || (a[0] < b[0] ? -1 : 1))[0]!;
  return `${top} ${Math.round((k / members.length) * 100)}%`;
};

/** Whether a name contains an accepted word for the label (compared by word key, any language rule). */
function hits(name: string, label: string): boolean {
  const gold = (GOLD_NAMES as Record<string, string[]>)[label];
  if (!gold) return false;
  const keys = (w: string) => [wordKey(w), wordKey(w, "no"), w];
  const goldKeys = new Set(gold.flatMap((g) => keys(g.toLowerCase())));
  return name.toLowerCase().match(/\p{L}[\p{L}-]*/gu)?.some((w) => keys(w).some((k) => goldKeys.has(k))) ?? false;
}
const topLabel = (labels: readonly string[][], members: readonly number[]) => {
  const c = new Map<string, number>();
  for (const i of members) for (const l of labels[i]!) c.set(l, (c.get(l) ?? 0) + 1);
  const [top, k] = [...c].sort((a, b) => b[1] - a[1] || (a[0] < b[0] ? -1 : 1))[0]!;
  return { top, share: k / members.length };
};

const p = await InferenceProcess.start({ entry: productionChildEntry(ROOT), modelDir: resolveModelDir({ env: process.env, root: ROOT }) });
const summary: string[] = ["# Spike v3, step 2: names", "", "Generated by `names-v3.mts`.", ""];
const conceptVecs: Float32Array[] = [];
for (const c of CONCEPTS) conceptVecs.push(await p.embedQuery(c.name));
const TAUS = [0.78, 0.8, 0.82, 0.84, 0.86];
try {
  for (const [set, file] of [["dev", v1File], ["test", v2File]] as const) {
    const items = load(set, file, ROOT);
    const { centred } = productionVectors(items);
    const h = buildHierarchy(centred);
    const titles = items.map((c) => c.title);
    const namers = { text: createNamer(items.map((c) => namingDoc(c, true))), title: createNamer(items.map((c) => namingDoc(c, false))) };
    type Variant = { name: string; theme: (m: number[]) => string; topic: (m: number[], theme: number[]) => string; words?: boolean };
    const wordsName = (namer: (typeof namers)["text"], m: number[], exclude?: Set<string>) => {
      const w = namer.name(m, exclude);
      return { label: displayName(w.words, typicalTitles(m.map((i) => titles[i]!), 1)), fallback: w.words.length === 0, keys: w.keys };
    };
    const variants: Variant[] = [
      { name: "three typical titles (the earlier experimental view)", theme: (m) => typicalTitles(m.map((i) => titles[i]!), 3, 40).join(" · "), topic: (m) => typicalTitles(m.map((i) => titles[i]!), 3, 40).join(" · ") },
      { name: "most typical title", theme: (m) => typicalTitles(m.map((i) => titles[i]!), 1)[0] ?? "", topic: (m) => typicalTitles(m.map((i) => titles[i]!), 1)[0] ?? "" },
      { name: "words from titles", theme: (m) => wordsName(namers.title, m).label, topic: (m) => wordsName(namers.title, m).label, words: true },
      { name: "words from titles + user messages", theme: (m) => wordsName(namers.text, m).label, topic: (m) => wordsName(namers.text, m).label, words: true },
      {
        name: "words from titles + user messages, topic without its theme's words",
        theme: (m) => wordsName(namers.text, m).label,
        topic: (m, theme) => wordsName(namers.text, m, new Set(namers.text.name(theme).keys)).label,
        words: true,
      },
    ];
    const nearest = (centroid: Float64Array, broad: boolean, skip: ReadonlySet<string> = new Set()) => {
      const ranked = CONCEPTS.map((c, i) => ({ name: c.name, broad: c.broad, s: cos(conceptVecs[i]!, centroid) }))
        .filter((c) => c.broad === broad && !skip.has(c.name))
        .sort((a, b) => b.s - a.s);
      return { name: ranked[0]!.name, s: ranked[0]!.s, margin: ranked[0]!.s - ranked[1]!.s };
    };
    const centroidOf = new Map<string, Float64Array>();
    const centroid = (m: number[]) => {
      const k = m.join(",");
      if (!centroidOf.has(k)) centroidOf.set(k, meanRaw(items, m));
      return centroidOf.get(k)!;
    };
    const conceptName = (m: number[], broad: boolean, tau: number | null, skip?: Set<string>) => {
      const c = nearest(centroid(m), broad, skip);
      if (tau !== null && c.s < tau) return { label: wordsName(namers.text, m).label, concept: false, s: c.s };
      return { label: c.name, concept: true, s: c.s };
    };
    variants.push({ name: "concept (nearest, no threshold)", theme: (m) => conceptName(m, true, null).label, topic: (m) => conceptName(m, false, null).label });
    for (const tau of TAUS)
      variants.push({ name: `concept if similarity ≥ ${tau}, else words`, theme: (m) => conceptName(m, true, tau).label, topic: (m) => conceptName(m, false, tau).label });
    // Topic hybrids: a topic keeps its nearest concept only if no sibling topic (same theme) has the
    // same nearest concept with a higher similarity; otherwise words, then the most typical title.
    const siblingWinner = new Map<string, string>();
    for (const t of h.themes) {
      const best = new Map<string, { key: string; s: number }>();
      for (const m of t.topics) {
        const c = nearest(centroid(m), false);
        const cur = best.get(c.name);
        if (!cur || c.s > cur.s) best.set(c.name, { key: m.join(","), s: c.s });
      }
      for (const [name, w] of best) siblingWinner.set(w.key, name);
    }
    const uniqueConcept = (m: number[]) => siblingWinner.get(m.join(","));
    const wordsOrTitle = (m: number[]) => wordsName(namers.text, m);
    variants.push({ name: "topics: unique concept, else words, else title (themes: concept)", theme: (m) => conceptName(m, true, null).label, topic: (m) => uniqueConcept(m) ?? wordsOrTitle(m).label });
    variants.push({ name: "topics: words, else unique concept, else title (themes: concept)", theme: (m) => conceptName(m, true, null).label, topic: (m) => { const w = wordsOrTitle(m); return !w.fallback ? w.label : uniqueConcept(m) ?? w.label; } });
    variants.push({ name: "topics: two typical titles (themes: concept)", theme: (m) => conceptName(m, true, null).label, topic: (m) => typicalTitles(m.map((i) => titles[i]!), 2, 40).join(" · ") });
    // Themes: each concept names at most one theme. Pairs (theme, one of its 5 nearest concepts) are
    // taken in order of similarity; a theme left without one is named by its words.
    const themeConcept = new Map<string, string>();
    {
      const pairs = h.themes.flatMap((t) =>
        CONCEPTS.map((c, i) => ({ key: t.members.join(","), name: c.name, broad: c.broad, s: cos(conceptVecs[i]!, centroid(t.members)) }))
          .filter((c) => c.broad)
          .sort((a, b) => b.s - a.s)
          .slice(0, 5),
      );
      pairs.sort((a, b) => b.s - a.s);
      const used = new Set<string>();
      for (const p of pairs) {
        if (themeConcept.has(p.key) || used.has(p.name)) continue;
        themeConcept.set(p.key, p.name);
        used.add(p.name);
      }
    }
    const uniqueTheme = (m: number[]) => themeConcept.get(m.join(",")) ?? wordsName(namers.text, m).label;
    variants.push({ name: "themes: unique concept; topics: two typical titles", theme: uniqueTheme, topic: (m) => typicalTitles(m.map((i) => titles[i]!), 2, 40).join(" · ") });
    const themes = h.themes.map((t) => t.members);
    const topics = h.themes.flatMap((t) => t.topics.map((m) => ({ m, theme: t.members })));
    const themeCentroids = themes.map((m) => meanRaw(items, m));
    const topicCentroids = topics.map(({ m }) => meanRaw(items, m));
    summary.push(`## ${set === "dev" ? "Dev set (v1)" : "Test set (v2)"}: ${items.length} conversations, ${themes.length} themes (t = ${h.themeCut}), ${topics.length} topics (t = ${h.topicCut}), ${h.themes.reduce((n, t) => n + t.loose.length, 0)} loose, ${h.other.length} other`, "");
    summary.push("| Naming | Hits label: themes | Hits label: topics | Themes MRR | Topics MRR | Mean length (themes / topics) | Coverage (themes / topics) | Fell back to a title (themes / topics) |", "| --- | --- | --- | --- | --- | --- | --- | --- |");
    const themeLab = items.map((c) => c.themes);
    const topicLab = items.map((c) => c.topics);
    const gold = (labels: string[], groups: number[][], lab: string[][]) => {
      let hit = 0;
      let counted = 0;
      groups.forEach((m, g) => {
        const t = topLabel(lab, m);
        if (t.share < 0.5 || !(GOLD_NAMES as Record<string, string[]>)[t.top]) return;
        counted++;
        if (hits(labels[g]!, t.top)) hit++;
      });
      return `${Math.round((hit / Math.max(1, counted)) * 100)}% of ${counted}`;
    };
    const memo = new Map<string, Float32Array>();
    const embed = async (t: string) => {
      if (!memo.has(t)) memo.set(t, await p.embedQuery(t));
      return memo.get(t)!;
    };
    const docKeys = items.map((c) => new Set(words(`${c.title ?? ""}\n${namingDoc(c, true).text}`).map((w) => wordKey(w, mainLang(c)))));
    for (const v of variants) {
      const score = async (labels: string[], centroids: Float64Array[]) => {
        let top1 = 0;
        let mrr = 0;
        for (let g = 0; g < labels.length; g++) {
          const q = await embed(labels[g]!);
          const own = cos(q, centroids[g]!);
          const rank = 1 + centroids.filter((c, j) => j !== g && cos(q, c) > own).length;
          if (rank === 1) top1++;
          mrr += 1 / rank;
        }
        return { top1: top1 / labels.length, mrr: mrr / labels.length };
      };
      const themeLabels = themes.map((m) => v.theme(m));
      const topicLabels = topics.map(({ m, theme }) => v.topic(m, theme));
      const a = await score(themeLabels, themeCentroids);
      const b = await score(topicLabels, topicCentroids);
      let cov = "—";
      let fb = "—";
      if (v.words) {
        const coverage = (label: string, m: number[]) => {
          const keys = label.split(", ").map((w, i) => wordKey(i === 0 ? w.charAt(0).toLowerCase() + w.slice(1) : w));
          return m.filter((i) => keys.some((k) => docKeys[i]!.has(k) || [...docKeys[i]!].some((x) => x === k))).length / m.length;
        };
        const avg = (xs: number[]) => xs.reduce((s, x) => s + x, 0) / Math.max(1, xs.length);
        cov = `${Math.round(avg(themes.map((m, g) => coverage(themeLabels[g]!, m))) * 100)}% / ${Math.round(avg(topics.map(({ m }, g) => coverage(topicLabels[g]!, m))) * 100)}%`;
        const namer = v.name === "words from titles" ? namers.title : namers.text;
        fb = `${themes.filter((m) => namer.name(m).words.length === 0).length} / ${topics.filter(({ m }) => namer.name(m).words.length === 0).length}`;
      }
      const len = (xs: string[]) => Math.round(xs.reduce((n, x) => n + x.length, 0) / Math.max(1, xs.length));
      summary.push(`| ${v.name} | ${gold(themeLabels, themes, themeLab)} | ${gold(topicLabels, topics.map((t) => t.m), topicLab)} | ${a.mrr.toFixed(2)} | ${b.mrr.toFixed(2)} | ${len(themeLabels)} / ${len(topicLabels)} | ${cov} | ${fb} |`);
    }
    summary.push("");

    // Listings: blind (no labels) and scored (with the labels), for the production naming.
    const prod = variants[Number(process.env.V3_LISTING ?? 4)]!;
    const blind: string[] = [`# ${set} set: themes → topics (blind: no labels)`, ""];
    const scored: string[] = [`# ${set} set: themes → topics, with labels (theme / topic majority and share)`, ""];
    const langs = (m: number[]) => {
      const c = new Map<string, number>();
      for (const i of m) c.set(items[i]!.lang, (c.get(items[i]!.lang) ?? 0) + 1);
      return [...c].sort((a, b) => b[1] - a[1]).map(([l, k]) => `${l} ${k}`).join(", ");
    };
    h.themes.forEach((t, ti) => {
      const head = `## ${ti + 1}. ${prod.theme(t.members)} (${t.members.length}; ${langs(t.members)})`;
      blind.push(head);
      scored.push(`${head} — theme label: ${majority(items.map((c) => c.themes), t.members)}`);
      for (const m of t.topics) {
        const line = `- **${prod.topic(m, t.members)}** (${m.length}): ${typicalTitles(m.map((i) => titles[i]!), 3, 45).join(" | ")}`;
        blind.push(line);
        scored.push(`${line} — ${majority(items.map((c) => c.topics), m)}`);
      }
      if (t.loose.length > 0) {
        const line = `- loose (${t.loose.length}): ${typicalTitles(t.loose.map((i) => titles[i]!), 4, 40).join(" | ")}`;
        blind.push(line);
        scored.push(line);
      }
      blind.push("");
      scored.push("");
    });
    blind.push(`Other (${h.other.length}): ${typicalTitles(h.other.map((i) => titles[i]!), 12, 40).join(" | ")}`);
    scored.push(`Other (${h.other.length}): ${h.other.map((i) => `${titles[i] ?? "—"} [${items[i]!.topics[0]}]`).slice(0, 20).join(" | ")}`);
    fs.writeFileSync(path.join(outDir, `listing-${set}-blind.md`), blind.join("\n") + "\n");
    fs.writeFileSync(path.join(outDir, `listing-${set}-labelled.md`), scored.join("\n") + "\n");
  }
} finally {
  await p.close();
}
fs.writeFileSync(path.join(outDir, "names.md"), summary.join("\n") + "\n");
console.log(summary.join("\n"));
