# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# ThreadAtlas privacy: never commit imported data or databases.
# Real ChatGPT exports and anything derived from them stay local.
# Synthetic test fixtures live under tests/fixtures/ and ARE committed.
# ---------------------------------------------------------------
/data/
/exports/
/imports/
*.db
*.db-journal
*.db-wal
*.db-shm
*.db.lock
*.sqlite
*.sqlite3
*.sqlite-journal
# ChatGPT export artefacts anywhere outside tests/fixtures/
conversations*.json
chat.html
*.zip
!tests/fixtures/**
# Finder metadata, even inside tests/fixtures/
tests/fixtures/**/.DS_Store

# Prisma Client, generated by `npm run db:generate`
/src/generated/

# Logs (server, test and tool output can quote imported text). Already-tracked
# spike results stay tracked; add new ones with `git add -f` after review.
*.log
/logs/

# Model files anywhere (the app keeps the model in data/models/, ignored above)
/models/
*.onnx
*.onnx_data
*.safetensors

# Personal Claude Code settings (the shared .claude/settings.json is committed)
.claude/settings.local.json

# The detailed development log (session handoffs, approvals, notes on the local
# database) stays on this machine; docs/PROGRESS.md is the public summary.
/docs/internal/
